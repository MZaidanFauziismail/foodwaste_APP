{
  "name": "ecoshare-backend",
  "version": "1.0.0",
  "description": "ExpressJS API for EcoShare Flutter app with PostgreSQL, Firebase Auth/FCM bridge, and ML scoring.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql \"$DATABASE_URL\" -f database/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f database/seed.sql",
    "lint:syntax": "node --check src/server.js && node --check src/app.js && node --check src/services/mlService.js",
    "firebase:seed-users": "node scripts/createFirebaseTestUsers.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
