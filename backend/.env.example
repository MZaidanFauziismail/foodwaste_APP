NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ecoshare:ecoshare_password@localhost:5432/ecoshare_db
AUTH_SECRET=change_this_secret_for_local_fallback_jwt
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# Optional Firebase Admin SDK configuration.
# Use this when Flutter is built with --dart-define=USE_FIREBASE_AUTH=true.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Recommended for Railway/Render/VPS: paste base64 JSON service-account here.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative for local server: path to service account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
# true = backend sends FCM push for new messages/requests when fcm_token exists.
FIREBASE_MESSAGING_ENABLED=false
